<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/admin.css">
</head>
<body>
  <div class="login">
    <div class="card login-card">
      <div class="login-brand">
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand-text">
          BizSpark AI
          <small>Admin</small>
        </span>
      </div>
      <span class="eyebrow">Platform Control</span>
      <h1>Sign in</h1>
      <p class="muted">Manage clients, generated websites, subscriptions, and deployments.</p>
      <% if (error) { %>
        <p class="login-error" role="alert"><%= error %></p>
      <% } %>
      <form class="stack" method="post" action="/admin/login">
        <label>
          Email
          <input name="email" type="email" value="<%= bootstrapEmail %>" required autocomplete="username">
        </label>
        <label>
          Password
          <input name="password" type="password" required autocomplete="current-password">
        </label>
        <button type="submit" class="button button--primary">Log in</button>
      </form>
    </div>
  </div>
</body>
</html>
