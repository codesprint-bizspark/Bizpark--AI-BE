<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title || 'Bizpark Admin' %></title>
  <link rel="stylesheet" href="/admin.css">
</head>
<body>
<div class="shell">
  <aside class="sidebar">
    <div class="brand">BizSpark AI Admin</div>
    <%
      const activePath = typeof currentPath !== 'undefined' ? currentPath : '';
      const isActiveNav = (path) => path === '/admin'
        ? activePath === '/admin'
        : activePath === path || activePath.startsWith(`${path}/`);
    %>
    <nav class="nav">
      <a class="<%= isActiveNav('/admin') ? 'is-active' : '' %>" <%= isActiveNav('/admin') ? 'aria-current="page"' : '' %> href="/admin">Dashboard</a>
      <a class="<%= isActiveNav('/admin/businesses') ? 'is-active' : '' %>" <%= isActiveNav('/admin/businesses') ? 'aria-current="page"' : '' %> href="/admin/businesses">Businesses</a>
      <a class="<%= isActiveNav('/admin/websites') ? 'is-active' : '' %>" <%= isActiveNav('/admin/websites') ? 'aria-current="page"' : '' %> href="/admin/websites">Websites</a>
      <a class="<%= isActiveNav('/admin/mobile-apps') ? 'is-active' : '' %>" <%= isActiveNav('/admin/mobile-apps') ? 'aria-current="page"' : '' %> href="/admin/mobile-apps">Mobile Apps</a>
      <a class="<%= isActiveNav('/admin/agent-tasks') ? 'is-active' : '' %>" <%= isActiveNav('/admin/agent-tasks') ? 'aria-current="page"' : '' %> href="/admin/agent-tasks">Agent Tasks</a>
      <a class="<%= isActiveNav('/admin/subscriptions') ? 'is-active' : '' %>" <%= isActiveNav('/admin/subscriptions') ? 'aria-current="page"' : '' %> href="/admin/subscriptions">Subscriptions</a>
      <a class="<%= isActiveNav('/admin/users') ? 'is-active' : '' %>" <%= isActiveNav('/admin/users') ? 'aria-current="page"' : '' %> href="/admin/users">Users</a>
    </nav>
    <div class="sidebar-account">
      <% if (admin) { %>
        <div class="sidebar-profile-card">
          <span class="admin-avatar"><%= (admin.name || 'A').trim().charAt(0).toUpperCase() %></span>
          <span class="admin-profile-copy">
            <strong><%= admin.name %></strong>
            <small><%= admin.role %></small>
          </span>
        </div>
      <% } %>
      <form class="logout" method="post" action="/admin/logout">
        <button type="submit">Log out</button>
      </form>
    </div>
  </aside>
  <main class="main">
    <div class="topbar">
      <h1><%= title || 'Admin' %></h1>
    </div>
