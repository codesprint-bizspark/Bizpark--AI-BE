# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection URL (can be the same Neon DB as the main project)
# Commerce creates a separate schema per tenant: tenant_<tenantId>
COMMERCE_DATABASE_URL="postgresql://neondb_owner:<password>@<your-neon-host>.neon.tech/neondb?sslmode=require"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST="localhost"
REDIS_PORT="6379"

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-strong-secret"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT="3003"

# ─── Debug ───────────────────────────────────────────────────────────────────
# Set to "true" to see SQL queries in console
TYPEORM_LOGGING="false"

# Supabase Storage (product image uploads, S3-compatible)
SUPABASE_PROJECT_URL=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_S3_ENDPOINT=
SUPABASE_STORAGE_REGION=ap-northeast-1
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
